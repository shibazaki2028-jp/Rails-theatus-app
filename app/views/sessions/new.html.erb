<% @page_title = "ログインフォーム" %>
<h1><%= @page_title %></h1>

<% if flash.alert %><p class="alert"><%= flash.alert %></p><% end %>
<%= form_tag :session, id: "login-form" do %>
  <div>
    <%= link_to "会員登録はこちら", new_account_path %>
  </div>
  <div>
    <label>メールアドレス：</label>
    <input type="text" name="email">
  </div>
  <div>
    <label>パスワード：</label>
    <input type="password" name="password">
  </div>
  <div>
    <input type="submit" value="ログイン">
  </div>

<% end %>