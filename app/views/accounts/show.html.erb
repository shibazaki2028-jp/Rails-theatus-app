<% @page_title = "マイページ" %>

<h1><%= @page_title %></h1>

<table class="attr">
  <tr>
    <th>ユーザー名</th>
    <td><%= @account.user_name %></td>
  </tr>
  <tr>
    <th>メールアドレス</th>
    <td><%= @account.email %></td>
  </tr>
  <% if current_account.theater_admin? %>
    <tr>
      <th>担当映画館</th>
      <td><%= @account.theater.name || "未割り当て" %></td>
    </tr>
  <% end %>
</table>
<ul class="toolbar">
  <%= link_to "アカウント情報の編集", :edit_account %>
  <%= link_to "予約一覧", reservations_path, class: "button" %>
  <%= button_to "退会する", [current_account], 
              method: :delete, 
              onclick: "return confirm('本当に削除しますか？');",
              form: { data: { turbo: false } }, 
              class: "button-delete" %>
</ul>