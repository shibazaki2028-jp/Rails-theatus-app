<% @page_title = "マイページ" %>

<h1><%= @page_title %></h1>

<table class="attr">
  <tr>
    <th>ユーザー名</th>
    <td><%= @account.user_name %></td>
  </tr>
  <tr>
    <th>メールアドレス</th>
    <td><%= @account.email %></td>
  </tr>
  <% if current_account.theater_admin? %>
    <tr>
      <th>担当映画館</th>
      <td><%= @account.theater.name %></td>
    </tr>
  <% end %>
</table>
<ul class="toolbar">
  <%= link_to "アカウント情報の編集", :edit_account %>
  <%= link_to "予約一覧", reservations_path, class: "button" %>
</ul>