<% @page_title = "新規会員登録" %>

<h1><%= @page_title %></h1>

<%= render "shared/errors", obj: @account %>
<%= form_for @account do |form| %>
  <!-- >renderメソッドで部分テンプレート「_form.html.erb」を埋め込み<-->
  <%= render "shared/account_form", form: form %>
  <!-- >submitメソッドで送信ボタン<-->
  <div><%= form.submit value="会員登録" %></div>
<% end %>


<%= link_to "既にアカウントをお持ちの方（ログイン）", new_session_path %>

