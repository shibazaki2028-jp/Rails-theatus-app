<% @page_title = "会員情報編集" %>

<h1><%= @page_title %></h1>

<%= link_to "マイページ", account_path(current_account) %>

<%= form_for @account do |form| %>
  <!-- >renderメソッドで部分テンプレート「_form.html.erb」を埋め込み<-->
  <%= render "shared/account_form", form: form %>
  <!-- >submitメソッドで送信ボタン<-->
  <div><%= form.submit value="情報更新" %></div>
<% end %>