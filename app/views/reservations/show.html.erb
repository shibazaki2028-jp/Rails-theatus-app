<% @page_title = "予約詳細" %>
<h1><%= @page_title %></h1>

<div class="reservation-info">
  <p>映画タイトル: <strong><%= @schedule.movie.title %></strong></p>
  <p>上映開始: <%= @schedule.screened_at.strftime("%H:%M") %></p>
  <p>映画館 / スクリーン: <%= @schedule.theater.name %> / <%= @schedule.screen.info %></p>

  <h3>予約内容</h3>
  <ul>
    <% @reservation.reservation_details.each do |detail| %>
      <li>
        座席: <%= detail.seat.seat_name %> 
        (<%= detail.price.ticket_type %>: <%= detail.price.price %>円)
      </li>
    <% end %>
  </ul>

  <hr>
  <p>
    <strong>合計金額: <%= @reservation.reservation_details.joins(:price).sum(:price) %>円</strong>
  </p>
</div>

<%= link_to "予約を編集する", edit_reservation_path(@reservation), class: "button" %>
<%= button_to "予約をキャンセルする", 
                reservation_path(@reservation), 
                method: :delete, 
                onclick: "return confirm('本当に削除しますか？');",
                class: "button-danger" %>

<%= link_to "一覧に戻る", reservations_path, class: "button" %>