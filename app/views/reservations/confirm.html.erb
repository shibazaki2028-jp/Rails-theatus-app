<h1>予約内容の確認</h1>

<div class="confirm-box">
  <p>以下の内容で予約を確定しますか？</p>
  
  <table class="list">
    <tr>
      <th>座席</th>
      <th>料金種別</th>
    </tr>
    <% @selected_seats.each do |seat| %>
      <tr>
        <td><%= seat.queue %> - <%= seat.verse %></td>
        <td>
          <% price_id = @prices[seat.id.to_s] %>
          <% price = @selected_prices.fetch(@prices.fetch(seat.id.to_s)) %>
          <%= price.price %>円
        </td>
      </tr>
    <% end %>
  </table>

  <p><strong>合計金額：</strong>
    <%= @sum_price %>円
  </p>

  <%= form_with url: schedule_reservations_path(@schedule), local: true do |f| %>
    <% @seat_ids.each do |id| %>
      <%= hidden_field_tag "seat_ids[]", id %>
      <%= hidden_field_tag "prices[#{id}]", @prices[id.to_s] %>
    <% end %>

    <div class="actions">
      <%= f.submit "この内容で確定する", class: "btn-primary" %>
      <%= link_to "座席を選び直す", :back, class: "btn-secondary" %>
    </div>
  <% end %>
</div>