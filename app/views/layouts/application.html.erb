<!DOCTYPE html>
<html>
  <head>
    <title>Theatus - 映画予約システム</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body>
    <header class="main-header">
      <div class="header-logo">
        <%= link_to "Theatus", :root %>
      </div>

      <nav class="header-nav">
        <ul>
          <li><%= link_to "映画一覧", movies_path %></li>
          <li><%= link_to "劇場案内", theaters_path %></li>
          
          <% if current_account %>
            <%# ログインしている時の表示 %>
            <li class="user-info">
              <span>ようこそ、<%= current_account.user_name %> さん</span>
            </li>
            <% if current_account&.theater_admin? || current_account&.system_admin? %>
              <%= link_to "【管理】映画館設定", system_admin_theaters_path %>
              <%= link_to "【管理】スケジュール一覧", system_admin_schedules_path %>
              <% if current_account&.system_admin? %>
              <%= link_to "【管理】映画登録", new_system_admin_movie_path %>
              <%= link_to "【管理】アカウント一覧", system_admin_accounts_path %>
              <% end %>
            <% end %>
            <li><%= link_to "マイページ", account_path(current_account) %></li>
            <li>
              <%= button_to "ログアウト", session_path, 
                  method: :delete, 
                  data: { confirm: "ログアウトしますか？" }%>
            </li>
          <% else %>
            <%# ログインしていない時の表示 %>
            <li><%= link_to "新規登録", new_account_path %></li>
            <li><%= link_to "ログイン", new_session_path, class: "login-btn" %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <main>
    <% if flash[:notice] %>
      <div class="flash notice"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="flash alert"><%= flash[:alert] %></div>
    <% end %>

      <%= yield %>
    </main>
  </body>
</html>

