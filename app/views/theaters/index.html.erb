<% @page_title = "映画館一覧" %>
<h1><%= @page_title %></h1>

<%= form_tag :search_theaters, method: :get, class: "search" do %>
  <%= text_field_tag :address, params[:address], placeholder: "住所" %>
  <%= submit_tag "検索" %>
<% end %>

<% if @theaters.present? %>
<table class = "list">
  <thead>
    <tr>
      <th>映画館名</th>
      <th>住所</th>
      <th>電話番号</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @theaters.each do |theater| %>
      <tr>
        <td><%= theater.name %></td>
        <td><%= theater.address %></td>
        <td><%= theater.formatted_telephone %></td>
        <td>
          <%= link_to "詳細", theater_path(theater) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% else %>
  <p>ご指定の条件に一致する映画館は見つかりませんでした。</p>
<% end %>