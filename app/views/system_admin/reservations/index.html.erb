<% @page_title = "予約一覧" %>
<h1><%= @page_title %></h1>

<%= link_to "アカウント詳細", system_admin_account_path(@account) %>

<% if @reservations.present? %>
  <table class = "list" >
    <thead>
      <tr>
        <th>上映日</th>
        <th>開始時間</th>
        <th>映画タイトル</th>
        <th>映画館 / スクリーン</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @reservations.each do |reservation| %>
        <tr>
          <td><%= reservation.schedule.screened_at.strftime("%Y/%m/%d") %></td>
          <td><%= reservation.schedule.screened_at.strftime("%H:%M") %></td>
          
          <td>*<%= reservation.schedule.movie.title %>*</td>
          <td><%= reservation.schedule.theater.name %>（<%= reservation.schedule.screen_id %>）</td>
                  
          <td>
            <%= link_to "詳細確認", reservation_path(reservation), class: "button" %>
            
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
<p>予約がありません</p>
<% end %>
