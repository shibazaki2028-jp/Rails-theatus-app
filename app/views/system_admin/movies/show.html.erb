<% @page_title = "映画の詳細" %>
<h1><%= @page_title %></h1>

<%= link_to "映画一覧", system_admin_movies_path %>

<table class="attr">
  <tr>
    <th width="150">タイトル</th>
    <td><%= @movie.title %></td>
  </tr>
  <tr>
    <th>カテゴリ</th>
    <td><%= @movie.category %></td>
  </tr>
  <tr>
    <th>上映時間</th>
    <td><%= @movie.screening_time %></td>
  </tr>
  <tr>
    <th>説明</th>
    <td><%= @movie.body %></td>
  </tr>
  <tr>
    <th>上映開始日</th>
    <td><%= @movie.published_on %></td>
  </tr>
  <tr>
    <th>上映終了日</th>
    <td><%= @movie.ended_on %></td>
  </tr>
  <tr>
    <th>公開</th>
    <td><%= @movie.publish ? "○" : "－" %></td>
  </tr>
</table>
