<% @page_title = "映画管理(システム管理者)" %>
<h1><%= @page_title %></h1>

<%= link_to "新規映画登録", new_system_admin_movie_path %>

<table class = "list" >
  <thead>
    <tr>
      <th>タイトル</th>
      <th>カテゴリ</th>
      <th>上映時間</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.category %></td>
        <td><%= movie.screening_time %>分</td>
        <td>
          <%= link_to "詳細", system_admin_movie_path(movie) %>
          <%= link_to "編集", edit_system_admin_movie_path(movie) %>
          <%= button_to "削除", [:system_admin, movie], 
              method: :delete, 
              onclick: "return confirm('本当に削除しますか？');",
              form: { data: { turbo: false } }, 
              class: "button-delete" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>