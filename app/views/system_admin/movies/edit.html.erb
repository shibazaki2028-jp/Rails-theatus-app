<% @page_title = "映画内容編集(システム管理者)" %>
<h1><%= @page_title %></h1>

<%= link_to "映画一覧", system_admin_movies_path %>

<%= form_for [:system_admin, @movie] do |form| %>
  <table class = "form-table">
    <tbody>
        <tr>
        <th><%= form.label :title, "タイトル" %></th>
        <td><%= form.text_field :title, size: 20 %></td>
    </tr>
    <tr>
        <th><%= form.label :category,  "カテゴリ" %></th>
        <td><%= form.text_field :category %></td>
    </tr>
    <tr>
        <th><%= form.label :screening_time,  "上映時間" %></th>
        <td><%= form.number_field :screening_time %></td>
    </tr>
    <tr>
        <th><%= form.label :body, "映画説明" %></th>
        <td><%= form.text_area :body, rows: 5 %></td>
      </tr>
      <tr>
        <th><%= form.label :published_on, "上映開始日" %></th>
        <td><%= form.date_field :published_on %></td>
      </tr>
      <tr>
        <th><%= form.label :ended_on, "上映終了日" %></th>
        <td><%= form.date_field :ended_on %></td>
      </tr>
      <tr>
        <th><%= form.label :publish, "公開" %></th>
        <td><%= form.check_box :publish %></td>
      </tr>
    </tbody>
  </table>
  <!-- >submitメソッドで送信ボタン<-->
  <div><%= form.submit %></div>
<% end %>
