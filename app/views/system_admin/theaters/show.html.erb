<% @page_title = "映画館の詳細" %>
<h1><%= @page_title %></h1>

<%= link_to "映画館一覧", system_admin_theaters_path %>

<table class="attr">
  <tr>
    <th width="150">映画館名</th>
    <td><%= @theater.name %></td>
  </tr>
  <tr>
    <th>住所</th>
    <td><%= @theater.address %></td>
  </tr>
  <tr>
    <th>電話番号</th>
    <td><%= @theater.formatted_telephone %></td>
  </tr>
</table>
