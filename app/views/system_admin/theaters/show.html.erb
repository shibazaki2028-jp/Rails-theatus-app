<% @page_title = "映画館の詳細(管理用)" %>
<h1><%= @page_title %></h1>

<%= link_to "映画館一覧", system_admin_theaters_path %>

<table class="attr">
  <tr>
    <th width="150">映画館名</th>
    <td><%= @theater.name %></td>
  </tr>
  <tr>
    <th>住所</th>
    <td><%= @theater.address %></td>
  </tr>
  <tr>
    <th>電話番号</th>
    <td><%= @theater.formatted_telephone %></td>
  </tr>
</table>
<% if current_account.system_admin? || current_account.theater == @theater %>
<%= link_to "上映スケジュール登録", new_system_admin_schedule_path %>
<%= link_to "スクリーン管理一覧", system_admin_theater_screens_path(@theater) %>
<% end %>
<% if current_account.theater == @theater %>
  <%= link_to "映画館の情報編集", edit_system_admin_theater_path(@theater) %>
<% end %>

<% @schedules.group_by { |s| s.screened_at.to_date }.each do |date, schedules_on_date| %>
  <h3><%= date %></h3>
  <% schedules_on_date.each do |schedule| %>
    <%= link_to "#{schedule.screened_at.strftime('%H:%M')}〜", new_reservation_path(schedule_id: schedule.id), class: "button" %>
  <% end %>
<% end %>