<% @page_title = "映画館管理(システム管理者)" %>
<h1><%= @page_title %></h1>

<%= link_to "新規映画館登録", new_system_admin_theater_path %>

<table class = "list" >
  <thead>
    <tr>
      <th>映画館名</th>
      <th>住所</th>
      <th>電話番号</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @theaters.each do |theater| %>
      <tr>
        <td><%= theater.name %></td>
        <td><%= theater.address %></td>
        <td><%= theater.formatted_telephone %></td>
        <td>
          <%= link_to "詳細", system_admin_theater_path(theater) %>
          <%= button_to "削除", [:system_admin, theater], 
              method: :delete, 
              onclick: "return confirm('本当に削除しますか？');",
              form: { data: { turbo: false } }, 
              class: "button-delete" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>