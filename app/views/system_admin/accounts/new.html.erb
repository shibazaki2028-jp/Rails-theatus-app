<% @page_title = "会員登録(システム管理者)" %>

<h1><%= @page_title %></h1>

<%= form_with(model: [:system_admin, @account]) do |f| %>

  <div>
    <%= f.label :user_name %>
    <%= f.text_field :user_name %>
  </div>

  <div>
    <%= f.label :email %>
    <%= f.text_field :email %>
  </div>

  <div>
    <%= f.label :password %>
    <%= f.text_field :password %>
  </div>

    <%= f.radio_button :role, "system_admin", id: "role_system" %>
    <%= f.label :role_0, "システム管理者" %>
    <%= f.radio_button :role, "theater_admin", id: "role_theater" %>
    <%= f.label :role_1, "映画館管理者" %>
    <%= f.radio_button :role, "general", id: "role_general" %>
    <%= f.label :role_2, "一般会員" %>

  <div class="theater-form-box">
    <p>担当する映画館を選択してください</p>
    <%= f.fields_for :administrator do |admin_f| %>
      <%= admin_f.collection_select :theater_id, Theater.all, :id, :name%>
    <% end %>
  </div>

  <hr>
  <%= f.submit "登録する" %>
<% end %>

