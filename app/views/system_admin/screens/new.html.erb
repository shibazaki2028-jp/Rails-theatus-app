<% @page_title = "スクリーン新規登録(システム管理者)" %>
<h1><%= @page_title %></h1>

<%= link_to "スクリーン一覧", system_admin_theater_screens_path(@theater) %>

<%= form_for [:system_admin, @theater, @screen] do |form| %>
  <table class = "form-table">
    <tbody>
    <tr>
        <th><%= form.label :info,  "スクリーンタイプ" %></th>
        <%= form.select :info, [
        ["スタンダード", "standard"],
        ["ラージ", "large"],
        ["スモール", "small"]],
        { include_blank: "選択してください" }, { class: "form-control" } %>    
    </tr>
    </tbody>
  </table>
  <!-- >submitメソッドで送信ボタン<-->
  <div><%= form.submit %></div>
<% end %>
