<% @page_title = "映画の詳細" %>
<h1><%= @page_title %></h1>

<%= link_to "映画一覧", movies_path %>

<table class="attr">
  <tr>
    <th width="150">タイトル</th>
    <td><%= @movie.title %></td>
  </tr>
  <tr>
    <th>カテゴリ</th>
    <td><%= @movie.category %></td>
  </tr>
  <tr>
    <th>上映時間</th>
    <td><%= @movie.screening_time %></td>
  </tr>
  <tr>
    <th>説明</th>
    <td><%= @movie.body %></td>
  </tr>
  <tr>
    <th>上映開始日</th>
    <td><%= @movie.published_on %></td>
  </tr>
  <tr>
    <th>上映終了日</th>
    <td><%= @movie.ended_on %></td>
  </tr>
  <tr>
    <th>公開</th>
    <td><%= @movie.publish ? "○" : "－" %></td>
  </tr>
</table>

<% @schedules.group_by { |s| s.screened_at.to_date }.each do |date, schedules_on_date| %>
  <h3><%= date %></h3>
  <% schedules_on_date.each do |schedule| %>
  <p><%= schedule.theater.name %>
    <%= schedule.screen.info %>
  </p>
    <%= link_to "#{schedule.screened_at.strftime('%H:%M')}〜", new_reservation_path(schedule_id: schedule.id), class: "button" %>
  <% end %>
<% end %>
