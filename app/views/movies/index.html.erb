<% @page_title = "映画一覧" %>
<h1><%= @page_title %></h1>

<%= form_tag :search_movies, method: :get, class: "search" do %>
  <%= text_field_tag :title, params[:title], placeholder: "映画名" %>
  <%= select_tag :category, 
        options_for_select(Movie.categories.keys, params[:category]), 
        include_blank: "未選択" %>
  <%= select_tag :name, 
               options_for_select(Theater.pluck(:name).uniq, params[:name]), 
               include_blank: "未選択" %>
<%= select_tag :publish, 
        options_for_select([["公開", true], ["公開予定", false]], params[:publish]), 
        include_blank: "全て" %>
  <%= submit_tag "検索" %>
<% end %>

<% if @movies.present? %>
<table  class="list" >
  <thead>
    <tr>
      <th>タイトル</th>
      <th>カテゴリ</th>
      <th>上映時間</th>
      <th>公開</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.category %></td>
        <td><%= movie.screening_time %>分</td>
        <td><%= movie.publish ? "○" : "－" %></td>
        <td>
          <%= link_to "詳細", movie_path(movie) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% else %>
  <p>ご指定の条件に一致する映画は見つかりませんでした。</p>
<% end %>